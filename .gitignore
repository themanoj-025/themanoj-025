# THEMEANOJ-025 — AI provenance & transparency negation block
# These files MUST remain tracked and visible. Nothing below may be
# shadowed by a preceding ignore rule — keep this block LAST in file.
!.gitignore
!.gitattributes
!.editorconfig
!.gitmessage

# ─── OS / Editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
$RECYCLE.BIN/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-*

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
ENV/
*.egg
*.whl
.eggs/
pip-wheel-metadata/
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ─── Build / Dist artifacts ────────────────────────────────────────
node_modules/
build/
dist/
*.egg
*.whl

# ─── Environment / Secrets ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.secrets.toml

# ─── Temporary capture frames / data ───────────────────────────────
assets/frames/

# ─── T2 managed block (bitbucket 재발방지를 위한 커밋 상태 점검용) ───────────────
# T2 managed block (repo-global rules via .git/info/exclude; kept as comments here so the
# repo-local .gitignore stays a valid pure-ignore catalog).
# Rules are applied system-wide by T2 (.git/info/exclude), e.g.:
#   *.log
#   docs/ai/
#   findings.json
#   ledger.jsonl
# REPO_MGMT(read)|REPO_MGMT(status)


# ─── OS junk ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
node_modules/
dist/
build/
.venv/
venv/
.env.local
.env.*

# ─── AI provenance & transparency negation block (T2 저장소 전역 rules에만 의거한 2차 보호) ──
# 아래 T2 managed block(/docs/ai/)이 docs/ai/ 전체를 ignore하므로,
# 이 검증용 커밋이 파탄나지 않도록 해당 파일은 force-visible 상태로 남긴다. (§5A.12)
!.gitignore
!.gitattributes
!.editorconfig
!.gitmessage
!docs/ai/PROMPTS.md
!docs/ai/

!docs/ai/PROVENANCE.md
!docs/ai/transcripts/README.md
