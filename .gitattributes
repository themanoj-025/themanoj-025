# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text eol=lf diff=python

# HTML templates
*.html text diff=html

# CSS stylesheets
*.css text

# JavaScript
*.js text
*.ts text
*.jsx text
*.tsx text

# Markdown documentation
*.md text eol=lf
*.rst text

# Config / data files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.cfg text
*.ini text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.pem -diff
*.key -diff
*.cert -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text
.dockerignore text

# Requirements
requirements.txt text
requirements*.txt text

# License / changelog
LICENSE text
CHANGELOG.md text

# Binary files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary
